# Device sync (optional). Leave both empty, or delete this file, to build without sync.
# To run your own sync: create a Supabase project, run supabase/migrations/0001_sync.sql,
# then copy this file to .env.local (local dev) and set the same variables in your host.
# Both values are public by design: the publishable key only lets the browser call the
# sync functions, and everything synced is encrypted on the device.
VITE_SYNC_URL=
VITE_SYNC_ANON_KEY=
