{
  "name": "patchbook-for-reliq",
  "version": "0.1.0",
  "private": true,
  "description": "Unofficial patch notebook for the Reliq Breakout Module: log every Matrix, CV, Gate and clock connection by Reliq track, module and jack.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "library": "tsx scripts/library.ts",
    "library:check": "tsx scripts/library.ts --check",
    "predev": "npm run library",
    "dev": "vite",
    "prebuild": "npm run library",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "npm run library && tsc --noEmit",
    "test": "npm run library && tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.3"
  }
}
